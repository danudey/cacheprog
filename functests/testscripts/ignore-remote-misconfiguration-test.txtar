# prepare client cacheprog environment with blank remote storage parameters,
# as happens in CI when dynamically provided variables are not set
mkdir -p $WORK/disk-cache
env CACHEPROG_ROOT_DIRECTORY=$WORK/disk-cache
env CACHEPROG_REMOTE_STORAGE_TYPE=s3 CACHEPROG_S3_BUCKET= CACHEPROG_S3_ACCESS_KEY_ID= CACHEPROG_S3_ACCESS_KEY_SECRET=
set-cacheprog GOCACHEPROG

# by default misconfigured remote storage fails the build
! go build -o test_bin$exe ./main.go
stderr 'failed to configure remote storage: bucket is required'

# with misconfiguration ignored the build falls back to local storage only
env CACHEPROG_IGNORE_REMOTE_MISCONFIGURATION=true
go build -o test_bin$exe ./main.go
stderr 'Remote storage is misconfigured; ignoring it and continuing with local storage only'
exec ./test_bin$exe
cmp stdout expected_output.txt
rm test_bin$exe

-- main.go --
package main

import "fmt"

func main() {
    fmt.Println("Hello world!")
}

-- expected_output.txt --
Hello world!
